{
    // Copy this file to c_cpp_properties.json to browse the clang-cl cross-build.
    // Configure that build first; this reads its compilation database.
    "configurations": [
        {
            "name": "Win32 clang-cl",
            // The workspace points cpptools at the CMake Tools provider for the
            // supported MSVC build, which would otherwise take precedence here.
            "configurationProvider": "",
            "compileCommands": "${workspaceFolder}/build/clang-cl/compile_commands.json",
            "intelliSenseMode": "windows-clang-x86",
            "cStandard": "c17",
            "cppStandard": "c++20"
        }
    ],
    "version": 4
}
