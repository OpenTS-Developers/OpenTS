{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug OpenTS: Debug build (GameD.exe)",
      "type": "cppvsdbg",
      "request": "launch",
      "preLaunchTask": "Build OpenTS: Debug",
      "program": "${workspaceFolder}/build/bin/Debug/GameD.exe",
      "args": ["-DATADIR=${workspaceFolder}/Run"],
      "cwd": "${workspaceFolder}/build/bin/Debug",
      "console": "internalConsole",
      "symbolSearchPath": "${workspaceFolder}/build/bin/Debug"
    },
    {
      "name": "Debug OpenTS: Release build (Game.exe)",
      "type": "cppvsdbg",
      "request": "launch",
      "preLaunchTask": "Build OpenTS: Release",
      "program": "${workspaceFolder}/build/bin/Release/Game.exe",
      "args": ["-DATADIR=${workspaceFolder}/Run"],
      "cwd": "${workspaceFolder}/build/bin/Release",
      "console": "internalConsole",
      "symbolSearchPath": "${workspaceFolder}/build/bin/Release"
    },
    {
      "name": "Attach to running OpenTS",
      "type": "cppvsdbg",
      "request": "attach",
      "processId": "${command:pickProcess}",
      "symbolSearchPath": "${workspaceFolder}/build/bin/Debug;${workspaceFolder}/build/bin/Release"
    }
  ]
}
