# Writes the version header and the build header. CMakeLists.txt runs this script at configure
# time and on every build, so the recorded commit follows HEAD without a reconfigure.
#
# The version header changes only with the declared version and the build header with every
# commit, so code that needs only the version is not recompiled after a commit. A header is
# rewritten only when its contents change.
#
# Expects OPENTS_VERSION_MAJOR, OPENTS_VERSION_MINOR, OPENTS_VERSION_PATCH,
# OPENTS_VERSION_PRERELEASE, OPENTS_VERSION_LABEL, OPENTS_OFFICIAL_BUILD, OPENTS_ARCH,
# OPENTS_SOURCE_DIR, OPENTS_VERSION_HEADER, and OPENTS_STAMP_HEADER to be set.

find_package(Git QUIET)
set(OPENTS_HAVE_GIT FALSE)
if(GIT_FOUND AND EXISTS "${OPENTS_SOURCE_DIR}/.git")
    set(OPENTS_HAVE_GIT TRUE)
endif()

# Sets <out> to the trimmed output of git run in the source tree, or to "" when git fails.
function(opents_git out)
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" ${ARGN}
        WORKING_DIRECTORY "${OPENTS_SOURCE_DIR}"
        OUTPUT_VARIABLE output
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET
        RESULT_VARIABLE result
    )
    if(NOT result EQUAL 0)
        set(output "")
    endif()
    set(${out} "${output}" PARENT_SCOPE)
endfunction()

# Saves and network sessions compare the packed version for equality. It holds one byte per
# component, so a component above 255 would give two versions the same stamp.
foreach(part MAJOR MINOR PATCH)
    if(OPENTS_VERSION_${part} GREATER 255)
        message(FATAL_ERROR
            "OpenTS version component ${part} is ${OPENTS_VERSION_${part}}; "
            "the packed version stamp allows at most 255.")
    endif()
endforeach()

math(EXPR OPENTS_VERSION_PACKED
    "(${OPENTS_VERSION_MAJOR} << 16) | (${OPENTS_VERSION_MINOR} << 8) | ${OPENTS_VERSION_PATCH}"
    OUTPUT_FORMAT HEXADECIMAL)

set(OPENTS_VERSION "${OPENTS_VERSION_MAJOR}.${OPENTS_VERSION_MINOR}.${OPENTS_VERSION_PATCH}")

# The label is OPENTS_VERSION_PRERELEASE, else OPENTS_VERSION_LABEL, else the label of a
# v<version>-<label> tag at HEAD. A plain v<version> tag at HEAD means no tag label, and of
# several label tags the highest in natural order wins.
set(label "${OPENTS_VERSION_PRERELEASE}")
if(label STREQUAL "")
    set(label "${OPENTS_VERSION_LABEL}")
endif()
if(label STREQUAL "" AND OPENTS_HAVE_GIT)
    opents_git(head_tags tag --points-at HEAD)
    string(REPLACE "\n" ";" head_tags "${head_tags}")
    string(REPLACE "." "\\." version_pattern "${OPENTS_VERSION}")
    set(tag_labels "")
    set(final_tag FALSE)
    foreach(tag IN LISTS head_tags)
        string(STRIP "${tag}" tag)
        if(tag STREQUAL "v${OPENTS_VERSION}")
            set(final_tag TRUE)
        elseif(tag MATCHES "^v${version_pattern}-([0-9A-Za-z.-]+)$")
            list(APPEND tag_labels "${CMAKE_MATCH_1}")
        endif()
    endforeach()
    list(LENGTH tag_labels tag_label_count)
    if(tag_label_count GREATER 0 AND NOT final_tag)
        list(SORT tag_labels COMPARE NATURAL)
        list(GET tag_labels -1 label)
    endif()
endif()
if(NOT label MATCHES "^[0-9A-Za-z.-]*$")
    message(FATAL_ERROR "OpenTS prerelease label '${label}' may contain only [0-9A-Za-z.-].")
endif()

set(OPENTS_IS_PRERELEASE 0)
if(NOT label STREQUAL "")
    string(APPEND OPENTS_VERSION "-${label}")
    set(OPENTS_IS_PRERELEASE 1)
endif()

set(VERSION_CONTENT
"/*******************************************************************************
 *                                O P E N  T S
 *******************************************************************************
 * SPDX-License-Identifier: GPL-3.0-or-later
 * Copyright 2026 OpenTS contributors
 *
 * See LICENSE.md for applicable additional terms and warranty disclaimers.
 ******************************************************************************/

/* Generated by cmake/GitStamp.cmake. Edits are overwritten by the next build. */

#pragma once

#define OPENTS_VERSION_MAJOR  ${OPENTS_VERSION_MAJOR}
#define OPENTS_VERSION_MINOR  ${OPENTS_VERSION_MINOR}
#define OPENTS_VERSION_PATCH  ${OPENTS_VERSION_PATCH}

/* Saves and network sessions compare this value. It leaves out the prerelease label, so a
   prerelease and its final release share it. */
#define OPENTS_VERSION_PACKED ${OPENTS_VERSION_PACKED}

#define OPENTS_VERSION        \"${OPENTS_VERSION}\"
#define OPENTS_IS_PRERELEASE  ${OPENTS_IS_PRERELEASE}

/* The numeric version fields of a VERSIONINFO resource. */
#define OPENTS_RC_FILEVERSION ${OPENTS_VERSION_MAJOR},${OPENTS_VERSION_MINOR},${OPENTS_VERSION_PATCH},0

/* A VERSIONINFO file flag, so that the resource compiler needs no prerelease branch of its
   own. It resolves only where a resource script has included the Windows version headers. */
#if OPENTS_IS_PRERELEASE
#define OPENTS_RC_PRERELEASE_FLAG VS_FF_PRERELEASE
#else
#define OPENTS_RC_PRERELEASE_FLAG 0x0L
#endif

#define OPENTS_ARCH \"${OPENTS_ARCH}\"
")

set(OPENTS_COMMIT "unknown")
set(OPENTS_BRANCH "unknown")
set(OPENTS_COMMIT_DATE "unknown")
set(OPENTS_COMMIT_DIRTY 0)

# Without git or a repository, as in a build from a source archive, the commit, branch and
# date stay "unknown".
if(OPENTS_HAVE_GIT)

    opents_git(GIT_COMMIT rev-parse --short HEAD)
    if(GIT_COMMIT)
        set(OPENTS_COMMIT "${GIT_COMMIT}")
    endif()

    opents_git(GIT_BRANCH rev-parse --abbrev-ref HEAD)
    if(GIT_BRANCH AND NOT GIT_BRANCH STREQUAL "HEAD")
        set(OPENTS_BRANCH "${GIT_BRANCH}")
    else()
        # A detached HEAD, as on a tag checkout or a pull-request build, has no branch name.
        # Use a ref that points at the commit: a tag first, then a local branch, then a remote one.
        opents_git(GIT_POINTING_REFS for-each-ref --points-at HEAD "--format=%(refname)"
                   refs/tags refs/heads refs/remotes)
        if(GIT_POINTING_REFS)
            string(REPLACE "\n" ";" GIT_POINTING_REFS "${GIT_POINTING_REFS}")
            foreach(prefix "refs/tags/" "refs/heads/" "refs/remotes/")
                foreach(ref IN LISTS GIT_POINTING_REFS)
                    string(STRIP "${ref}" ref)
                    # refs/remotes/<remote>/HEAD only records where a remote points.
                    if(ref MATCHES "^${prefix}" AND NOT ref MATCHES "/HEAD$")
                        string(REPLACE "${prefix}" "" OPENTS_BRANCH "${ref}")
                        break()
                    endif()
                endforeach()
                if(NOT OPENTS_BRANCH STREQUAL "unknown")
                    break()
                endif()
            endforeach()
        endif()
    endif()

    opents_git(GIT_DATE log -1 "--format=%cd" "--date=format:%Y-%m-%d %H:%M:%S")
    if(GIT_DATE)
        set(OPENTS_COMMIT_DATE "${GIT_DATE}")
    endif()

    # Only changes to tracked files mark the build as modified.
    opents_git(GIT_STATUS status --porcelain --untracked-files=no)
    if(NOT GIT_STATUS STREQUAL "")
        set(OPENTS_COMMIT_DIRTY 1)
    endif()

endif()

set(OPENTS_BUILD_DESCRIPTION "${OPENTS_COMMIT} on ${OPENTS_BRANCH}")
if(OPENTS_COMMIT_DIRTY)
    string(APPEND OPENTS_BUILD_DESCRIPTION " (modified)")
endif()

# The displayed version includes the commit unless the build is official or the commit is
# unknown.
if(OPENTS_OFFICIAL_BUILD OR OPENTS_COMMIT STREQUAL "unknown")
    set(OPENTS_VERSION_DISPLAY "${OPENTS_VERSION} (${OPENTS_ARCH})")
elseif(OPENTS_COMMIT_DIRTY)
    set(OPENTS_VERSION_DISPLAY "${OPENTS_VERSION} (${OPENTS_COMMIT}, modified, ${OPENTS_ARCH})")
else()
    set(OPENTS_VERSION_DISPLAY "${OPENTS_VERSION} (${OPENTS_COMMIT}, ${OPENTS_ARCH})")
endif()

set(STAMP_CONTENT
"/*******************************************************************************
 *                                O P E N  T S
 *******************************************************************************
 * SPDX-License-Identifier: GPL-3.0-or-later
 * Copyright 2026 OpenTS contributors
 *
 * See LICENSE.md for applicable additional terms and warranty disclaimers.
 ******************************************************************************/

/* Generated by cmake/GitStamp.cmake. Edits are overwritten by the next build. */

#pragma once

#include \"opents_version.h\"

#define OPENTS_COMMIT            \"${OPENTS_COMMIT}\"
#define OPENTS_BRANCH            \"${OPENTS_BRANCH}\"
#define OPENTS_COMMIT_DATE       \"${OPENTS_COMMIT_DATE}\"
#define OPENTS_COMMIT_DIRTY      ${OPENTS_COMMIT_DIRTY}

/* The commit and branch as one line, for reports with no room to lay the parts out. */
#define OPENTS_BUILD_DESCRIPTION \"${OPENTS_BUILD_DESCRIPTION}\"

/* The version shown to the player. It includes the commit unless the build is official or
   the commit is unknown. */
#define OPENTS_VERSION_DISPLAY   \"${OPENTS_VERSION_DISPLAY}\"
")

# Rewriting an identical header would make every build recompile its consumers.
function(write_if_changed path content)
    set(existing "")
    if(EXISTS "${path}")
        file(READ "${path}" existing)
    endif()
    if(NOT existing STREQUAL content)
        file(WRITE "${path}" "${content}")
        set(WROTE_HEADER TRUE PARENT_SCOPE)
    endif()
endfunction()

write_if_changed("${OPENTS_VERSION_HEADER}" "${VERSION_CONTENT}")
write_if_changed("${OPENTS_STAMP_HEADER}" "${STAMP_CONTENT}")

if(WROTE_HEADER)
    message(STATUS "OpenTS: build stamp ${OPENTS_VERSION_DISPLAY} on ${OPENTS_BRANCH}")
endif()
