#ifndef _MAC
/////////////////////////////////////////////////////////////////////////////
//
// Version
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION OPENTS_RC_FILEVERSION
 PRODUCTVERSION OPENTS_RC_FILEVERSION
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG | OPENTS_RC_PRERELEASE_FLAG
#else
 FILEFLAGS OPENTS_RC_PRERELEASE_FLAG
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", "\0"
            VALUE "CompanyName", "OpenTS contributors\0"
            VALUE "FileDescription", "OpenTS engine for Command & Conquer: Tiberian Sun\0"
            VALUE "FileVersion", OPENTS_VERSION "\0"
            VALUE "InternalName", "Sun\0"
            VALUE "LegalCopyright", "Copyright © 2000 Westwood Studios, © 2026 OpenTS contributors\0"
            VALUE "LegalTrademarks", "Command & Conquer is a trademark of Westwood Studios\0"
            VALUE "OriginalFilename", "Game.exe\0"
            VALUE "PrivateBuild", OPENTS_BUILD_DESCRIPTION "\0"
            VALUE "ProductName", "Command & Conquer : Tiberian Sun\0"
            VALUE "ProductVersion", OPENTS_VERSION_DISPLAY "\0"
            VALUE "SpecialBuild", "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

#endif    // !_MAC


/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_SUN                 ICON    DISCARDABLE     "sun.ico"
IDI_CHECKED             ICON    DISCARDABLE     "checked.ico"
IDI_UNCHECKED           ICON    DISCARDABLE     "unchecked.ico"
IDI_GREYED              ICON    DISCARDABLE     "greyed.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_TEMPLATE DIALOGEX 0, 0, 200, 100
STYLE WS_POPUP
EXSTYLE WS_EX_TRANSPARENT
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "This is a dialog of known size that is used to resize other dialogs.",
                    IDC_STATIC,17,23,154,23,WS_DISABLED,WS_EX_TRANSPARENT
    LTEXT           "Please don't change the size, and leave it as a popup, not a child!!!!",
                    IDC_STATIC,14,60,157,25,WS_DISABLED,WS_EX_TRANSPARENT
END


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MODE MENU DISCARDABLE 
BEGIN
    POPUP "&Mode"
    BEGIN
        MENUITEM "640 x 400",                   IDM_MODE_640X400, CHECKED
        MENUITEM "640 x 480",                   IDM_MODE_640X480
        MENUITEM "800 x 600",                   IDM_MODE_800X600
        MENUITEM "1024 x 768",                  IDM_MODE_1024X768
        MENUITEM "1280 x 1024",                 IDM_MODE_1280X1024
        MENUITEM SEPARATOR
    END
END


