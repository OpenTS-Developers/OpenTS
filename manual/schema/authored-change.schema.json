{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opents.example/manual/authored-change.schema.json",
  "title": "Authored lifecycle change frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "category", "release", "targets", "credit"],
  "properties": {
    "title": { "type": "string", "pattern": "\\S" },
    "category": { "enum": ["feature", "fix", "balance", "performance", "internal"] },
    "release": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "breaking": { "type": "boolean", "default": false },
    "migration": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "\\S" }
    },
    "targets": {
      "type": "array",
      "items": { "$ref": "#/$defs/target" }
    },
    "credit": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "effect"],
      "properties": {
        "type": { "enum": ["key", "action", "event", "mission", "format", "enum", "system", "command"] },
        "id": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "effect": { "enum": ["added", "changed", "deprecated", "removed"] }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "not": { "const": "key" } } } },
          "then": { "not": { "required": ["scope"] } }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["breaking"],
        "properties": { "breaking": { "const": true } }
      },
      "else": { "not": { "required": ["migration"] } }
    }
  ]
}
