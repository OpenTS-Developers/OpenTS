{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opents.example/manual/releases.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["releases"],
  "properties": {
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "status"],
        "properties": {
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
          "status": { "enum": ["development", "candidate", "released"] },
          "date": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "released" } } },
            "then": { "required": ["date"] },
            "else": { "not": { "required": ["date"] } }
          }
        ]
      }
    }
  }
}
