{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opents.example/manual/tombstones.schema.json",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["type", "id", "route", "search_aliases", "summary"],
    "properties": {
      "type": { "enum": ["key", "action", "event", "mission", "format", "enum", "system", "command"] },
      "id": { "type": "string", "minLength": 1 },
      "route": { "type": "string", "pattern": "^/.*/$" },
      "search_aliases": {
        "type": "array",
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1 }
      },
      "summary": { "type": "string", "pattern": "\\S" },
      "replacement": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "id"],
        "properties": {
          "type": { "enum": ["key", "action", "event", "mission", "format", "enum", "system", "command"] },
          "id": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        }
      }
    }
  }
}
