---
import { getCollection, render } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Feedback from '../../components/Feedback.astro';
import RelatedResources from '../../components/RelatedResources.astro';
import { UI } from '../../i18n/en.mjs';
import { relatedResourcesFor } from '../../lib/related';
import { siteConfig, sourceFileUrl } from '../../lib/site-config.mjs';
import { internalCategoryTitle } from '../../lib/taxonomy';

export async function getStaticPaths() {
	return (await getCollection('internals')).map((entry) => ({
		params: { id: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const revision = siteConfig.revision;
const related = await relatedResourcesFor(
	{ type: 'internal', id: entry.id },
	entry.data.related,
	`Internal page ${entry.id}`,
);
const pageHeadings = [
	...headings,
	...(related.length > 0 ? [{ depth: 2, slug: 'related-resources', text: 'Related resources' }] : []),
	{ depth: 2, slug: 'source-files', text: 'Source files' },
];
---

<StarlightPage frontmatter={{ title: entry.data.title, description: entry.data.summary }} headings={pageHeadings}>
	<Breadcrumb crumbs={[
		{ label: UI.navigation.internals, href: '/internals/' },
		{ label: internalCategoryTitle(entry.data.category) },
	]} />
	<p class="ots-lede">{entry.data.summary}</p>
	<Content />
	<RelatedResources resources={related} />
	<h2 id="source-files">Source files</h2>
	<p class="ots-source-revision">Linked at revision <code data-pagefind-ignore>{revision.slice(0, 12)}</code>.</p>
	<ul class="ots-source-files">
		{entry.data.source_files.map((path) => <li><a href={sourceFileUrl(path)}><code>{path}</code></a></li>)}
	</ul>
	<Feedback title={entry.data.title} path={`/internals/${entry.id}/`} />
</StarlightPage>
