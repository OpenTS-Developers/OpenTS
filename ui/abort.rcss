/*
 * Where the abort question puts its three answers, from IDD_MISSION_ABORT at 256 by 63
 * dialog units: 384 by 103 pixels, the question at 33,19 over 319 by 31, and three 91 wide
 * buttons at 33, 147 and 261. Everything visual comes from the kit.
 */

#reveal
{
	width: 384dp;
	height: 103dp;
	top: 50%;
	margin-top: -51dp;
}

#content
{
	padding: 19dp 33dp 0 33dp;
}

/*
 * A centred caption sits a pixel left of the middle when the room is odd, as the layer halves
 * it in whole pixels where the toolkit rounds a half up, so the box is padded on the right.
 */
#question
{
	height: 31dp;
	padding-right: 1dp;
	line-height: 17dp;
	text-align: center;
}

#buttons
{
	display: flex;
	margin-top: 10dp;
}

button
{
	width: 91dp;
	margin-right: 23dp;
}

#cancel
{
	margin-right: 0;
}
