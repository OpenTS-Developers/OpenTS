/*
 * Where the abort question puts its three answers, from IDD_MISSION_ABORT at 256 by 63
 * dialog units: 384 by 103 pixels, the question at 33,19 and three buttons at 33, 147 and
 * 261. The game draws each button 90 wide, a pixel short of what the template alone would
 * make it, so the sheet follows the game. Everything visual comes from the kit.
 */

#reveal
{
	width: 384dp;
	height: 103dp;
	top: 50%;
	margin-top: -51dp;
}

#content
{
	padding: 19dp 33dp 0 33dp;
}

/*
 * A centered caption sits a pixel left of the middle when the room is odd, as the layer halves
 * it in whole pixels where the toolkit rounds a half up, so the box is padded on the right.
 */
#question
{
	height: 31dp;
	padding-right: 1dp;
	line-height: 17dp;
	text-align: center;
}

#buttons
{
	display: flex;
	margin-top: 10dp;
}

button
{
	width: 90dp;
	margin-right: 24dp;
}

#cancel
{
	margin-right: 0;
}
