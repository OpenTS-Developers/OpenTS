<rml>
<head>
	<title>Abort mission</title>
	<link type="text/template" href="dialog.rml"/>
	<link type="text/rcss" href="abort.rcss"/>
</head>
<body template="dialog" data-model="abort" class="fitted">
	<p id="question">Do you want to abort the mission?</p>
	<div id="buttons">
		<button id="abort" data-event-click="queue('abort')">Abort</button>
		<button id="restart" data-class-disabled="!restartenabled" data-event-click="queue('restart')">{{restartcaption}}</button>
		<button id="cancel" data-event-click="queue('cancel')">[[TXT_CANCEL]]</button>
	</div>
</body>
</rml>
