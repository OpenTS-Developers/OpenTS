/*
 * Where the mode confirmation puts its question and its two answers, from IDD_OPT_CONFIRM_MODE
 * at 239 by 70 dialog units: 359 by 114 pixels, the text at 33,20 over 293 by 42, and the
 * buttons 75 wide at 167 and 251. Everything visual comes from the kit.
 */

#reveal
{
	width: 359dp;
	height: 114dp;
	top: 50%;
	margin-top: -57dp;
}

#content
{
	padding: 20dp 33dp 0 33dp;
}

#text
{
	height: 42dp;
	line-height: 15dp;
}

/* The pair ends at the right edge, so the gap between them is what sets the left one. */
#buttons
{
	display: flex;
	justify-content: flex-end;
	margin-top: 10dp;
}

button
{
	width: 75dp;
}

#ok
{
	margin-right: 9dp;
}
