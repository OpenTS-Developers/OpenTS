/*
 * Where the mode confirmation puts its question and its two answers, from IDD_OPT_CONFIRM_MODE
 * at 239 by 70 dialog units: 359 by 114 pixels, the text at 33,19 over 293 by 43, and the
 * buttons 75 wide at 166 and 250. Everything visual comes from the kit.
 */

#reveal
{
	width: 359dp;
	height: 114dp;
	top: 50%;
	margin-top: -57dp;
}

#content
{
	padding: 19dp 33dp 0 33dp;
}

#text
{
	height: 43dp;
	line-height: 15dp;
}

#buttons
{
	display: flex;
	margin-top: 9dp;
}

button
{
	width: 75dp;
}

#ok
{
	margin-left: 133dp;
	margin-right: 9dp;
}
