body
{
	width: 100%;
	height: 100%;
	font-family: "Open Sans";
	font-size: 13dp;
	color: #e6e6e6;
}

div, p
{
	display: block;
}

#panel
{
	position: absolute;
	left: 50%;
	top: 50%;
	width: 359dp;
	height: 105dp;
	margin-left: -180dp;
	margin-top: -53dp;
	background-color: #12181fdc;
	border: 1dp #5a8f6a;
}

#text
{
	position: absolute;
	left: 33dp;
	top: 18dp;
	width: 293dp;
	height: 40dp;
	overflow: hidden;
}

#text p
{
	line-height: 15dp;
}

button
{
	position: absolute;
	top: 66dp;
	width: 75dp;
	height: 23dp;
	display: block;
	text-align: center;
	line-height: 23dp;
	tab-index: auto;
	background-color: #2f4a5a;
	border: 1dp #6f95a8;
}

button:hover
{
	background-color: #3f6478;
}

button:active
{
	background-color: #24394a;
}

#ok
{
	left: 167dp;
}

#cancel
{
	left: 251dp;
}
