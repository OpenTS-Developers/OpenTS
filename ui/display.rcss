/*
 * Where the display options put their parts, from IDD_OPT_DISPLAY at 229 by 196 dialog
 * units: 344 by 320 pixels, everything inset 33 across and the first line at 19 down, the
 * mode list 278 by 179, and two 94 wide buttons at 33 and 217. The list is a pixel shorter
 * than the template alone would make it, as the game draws it. Everything visual comes
 * from the kit.
 */

#reveal
{
	width: 344dp;
	height: 320dp;
	top: 50%;
	margin-top: -160dp;
}

#content
{
	padding: 19dp 33dp 0 33dp;
}

/*
 * A caption is drawn from the top of its box, however tall the template makes the box, and a
 * centred one a pixel left of the middle when the room is odd: the layer halves the room in
 * whole pixels where the toolkit rounds a half up, so the box is padded a pixel on the right.
 */
.heading
{
	padding-right: 1dp;
	line-height: 17dp;
	text-align: center;
}

#title
{
	height: 15dp;
}

#modes-label
{
	margin-top: 7dp;
	height: 17dp;
}

#modes
{
	margin-top: 2dp;
	height: 179dp;
}

#switch-stretch
{
	margin-top: 10dp;
}

#buttons
{
	display: flex;
	margin-top: 9dp;
}

button
{
	width: 94dp;
}

#cancel
{
	margin-left: 90dp;
}
