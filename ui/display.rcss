/*
 * Where the display options put their parts, from IDD_OPT_DISPLAY at 229 by 196 dialog
 * units: 344 by 319 pixels, everything inset 33 across and the first line at 20 down, the
 * mode list 278 by 179, and two 93 wide buttons at the outer edges. Everything visual
 * comes from the kit.
 */

#reveal
{
	width: 344dp;
	height: 319dp;
	top: 50%;
	margin-top: -160dp;
}

#content
{
	padding: 20dp 33dp 0 33dp;
}

.heading
{
	text-align: center;
}

#title
{
	height: 15dp;
}

#modes-label
{
	margin-top: 6dp;
	height: 16dp;
}

#modes
{
	margin-top: 3dp;
	height: 179dp;
}

#switch-stretch
{
	margin-top: 10dp;
}

#buttons
{
	display: flex;
	justify-content: space-between;
	margin-top: 11dp;
}

button
{
	width: 93dp;
}
