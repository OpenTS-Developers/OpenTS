/*
 * Where the game controls put their parts. In a game it is IDD_OPT_CTRL_GAME_MP at 292 by
 * 175 dialog units, 438 by 286 pixels: three rows of a 95 wide label, a 192 by 25 slider and
 * a 75 wide reading, two columns of switches, and three 116 wide buttons. Out of one it is
 * IDD_OPT_CTRL_GAME_SP at 292 by 179, 438 by 292: 87 wide labels, 222 by 22 sliders with 68
 * wide readings, a fourth row for the difficulty and one button in the middle. The Internet
 * template drops the speed row and is otherwise the in-game one. Everything visual comes
 * from the kit.
 */

#reveal
{
	width: 438dp;
	height: 286dp;
	top: 50%;
	margin-top: -143dp;
}

/*
 * A difficulty row in a game is no template of the game's own: the front end is the only
 * place the original offers one. The screen still makes room for it, so a caller that asks
 * for both is laid out rather than cut off.
 */
.difficulty #reveal
{
	height: 336dp;
	margin-top: -168dp;
}

.frontend #reveal
{
	height: 292dp;
	margin-top: -146dp;
}

/* The controls reach a little closer to the right edge than to the left. */
#content
{
	padding: 19dp 27dp 0 33dp;
}

.row
{
	display: block;
	height: 25dp;
	white-space: nowrap;
}

.row + .row
{
	margin-top: 26dp;
}

#row-detail, #row-difficulty
{
	margin-top: 25dp;
}

.frontend .row
{
	height: 22dp;
}

.frontend .row + .row, .frontend #row-detail, .frontend #row-difficulty
{
	margin-top: 14dp;
}

/* A caption is drawn from the top of its box, however tall the template makes the box. */
.row > .caption
{
	width: 95dp;
	height: 25dp;
	margin-right: 7dp;
	line-height: 17dp;
	text-align: right;
}

.row > input[type='range']
{
	width: 192dp;
	height: 25dp;
}

.row > .value
{
	width: 75dp;
	height: 25dp;
	margin-left: 9dp;
	line-height: 17dp;
}

/* The front end gives the slider the room the reading and the label give up. */
.frontend .row > .caption
{
	width: 87dp;
	height: 22dp;
	margin-right: 0;
	text-align: left;
}

.frontend .row > input[type='range']
{
	width: 222dp;
	height: 22dp;
}

.frontend .row > .value
{
	width: 68dp;
	height: 22dp;
	margin-left: 1dp;
	text-align: right;
}

#switches
{
	display: flex;
	margin-top: 8dp;
}

.frontend #switches
{
	margin-top: 18dp;
}

#switches > .column
{
	width: 187dp;
}

.frontend #switches > .column
{
	width: 186dp;
}

#switches > .column > label.check + label.check
{
	margin-top: 10dp;
}

.frontend #switches > .column > label.check + label.check
{
	margin-top: 7dp;
}

.frontend #switches > .column > #switch-edge
{
	margin-top: 8dp;
}

/* Three buttons in a game, one out of one, placed where its template puts it. */
#buttons
{
	display: flex;
	margin-top: 12dp;
}

.frontend #buttons
{
	margin-top: 10dp;
}

#buttons > button
{
	width: 116dp;
}

#sound
{
	margin-right: 14dp;
}

#keyboard
{
	margin-right: 15dp;
}

.frontend #ok
{
	width: 195dp;
	margin-left: 88dp;
}
