/*
 * Where the game controls put their parts. In a game it is IDD_OPT_CTRL_GAME_MP at 292 by
 * 175 dialog units, 438 by 284 pixels: three rows of a 95 wide label, a 192 by 24 slider and
 * a 75 wide reading, two columns of switches, and three 116 wide buttons. Out of one it is
 * IDD_OPT_CTRL_GAME_SP at 292 by 179, 438 by 291: 87 wide labels, 222 by 21 sliders with 68
 * wide readings, a fourth row for the difficulty and one button in the middle. The Internet
 * template drops the speed row and is otherwise the in-game one. Everything visual comes
 * from the kit.
 */

#reveal
{
	width: 438dp;
	height: 284dp;
	top: 50%;
	margin-top: -142dp;
}

/*
 * A difficulty row in a game is no template of the game's own: the front end is the only
 * place the original offers one. The screen still makes room for it, so a caller that asks
 * for both is laid out rather than cut off.
 */
.difficulty #reveal
{
	height: 334dp;
	margin-top: -167dp;
}

.frontend #reveal
{
	height: 291dp;
	margin-top: -145dp;
}

/* The controls reach a little closer to the right edge than to the left. */
#content
{
	padding: 20dp 27dp 0 33dp;
}

.frontend #content
{
	padding-right: 26dp;
}

.row
{
	display: block;
	height: 24dp;
	white-space: nowrap;
}

.row + .row
{
	margin-top: 26dp;
}

.frontend .row
{
	height: 21dp;
}

.frontend .row + .row
{
	margin-top: 15dp;
}

.frontend #row-scroll
{
	margin-top: 14dp;
}

.row > .caption
{
	width: 95dp;
	margin-right: 7dp;
	line-height: 24dp;
	text-align: right;
}

.row > input[type='range']
{
	width: 192dp;
	height: 24dp;
}

.row > .value
{
	width: 75dp;
	margin-left: 9dp;
	line-height: 24dp;
}

/* The front end gives the slider the room the reading and the label give up. */
.frontend .row > .caption
{
	width: 87dp;
	margin-right: 0;
	line-height: 21dp;
	text-align: left;
}

.frontend .row > input[type='range']
{
	width: 222dp;
	height: 21dp;
}

.frontend .row > .value
{
	width: 68dp;
	margin-left: 2dp;
	line-height: 21dp;
	text-align: right;
}

#switches
{
	display: flex;
	margin-top: 9dp;
}

.frontend #switches
{
	margin-top: 19dp;
}

#switches > .column
{
	width: 189dp;
}

#switches > .column > label.check + label.check
{
	margin-top: 10dp;
}

.frontend #switches > .column > label.check + label.check
{
	margin-top: 7dp;
}

/* Three buttons in a game, one in the middle out of one. */
#buttons
{
	display: flex;
	margin-top: 12dp;
}

.frontend #buttons
{
	justify-content: center;
	margin-top: 11dp;
}

#buttons > button
{
	width: 116dp;
}

#sound
{
	margin-right: 15dp;
}

#keyboard
{
	margin-right: 14dp;
}

.frontend #ok
{
	width: 195dp;
}
