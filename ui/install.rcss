body
{
	display: flex;
	align-items: center;
	justify-content: center;
	background-color: #1a1d24;
	decorator: image(installer-background.png cover);
}

#panel
{
	position: relative;
	box-sizing: border-box;
	display: flex;
	flex-direction: column;
	width: 520dp;
	padding: 20dp 28dp;
	background-color: #0c0f14e6;
}

#status, #error, #done-text
{
	line-height: 16dp;
	white-space: pre-wrap;
	font-size: 12dp;
	color: #c9d1d9;
}

#notice
{
	margin-bottom: 4dp;
	line-height: 18dp;
	white-space: pre-wrap;
	font-size: 14dp;
	font-weight: bold;
	text-transform: uppercase;
	color: #f2f5f7;
}

#license
{
	margin-bottom: 4dp;
	line-height: 16dp;
	white-space: pre-wrap;
	font-size: 12dp;
	color: #c9d1d9;
}

#source
{
	line-height: 12dp;
	white-space: pre-wrap;
	font-size: 9dp;
	height: 12dp;
	color: #8c98a4;
}

.divider
{
	height: 1dp;
	margin-top: 6dp;
	background-color: #4eb6dc;
}

.hint
{
	margin-top: 6dp;
	line-height: 14dp;
	white-space: pre-wrap;
	font-size: 10dp;
	height: 14dp;
	color: #8c98a4;
}

#choices
{
	margin-top: 6dp;
}

.option
{
	display: flex;
	align-items: center;
	height: 22dp;
	font-size: 12dp;
	color: #c9d1d9;
}

.option.active
{
	color: #70ff00;
}

.option .name
{
	flex: 1;
}

.option .size
{
	width: 84dp;
	text-align: right;
	color: #8c98a4;
}

.option.active .size, .option.total .size
{
	color: #70ff00;
}

.option.sub
{
	padding-left: 16dp;
}

.option.total
{
	margin-top: 4dp;
	color: #70ff00;
}

#status
{
	height: 36dp;
	margin-top: 8dp;
}

#bar
{
	width: 100%;
	height: 22dp;
	margin-top: 6dp;
}

#bar fill
{
	background-color: #70ff00;
	decorator: horizontal-gradient(#70ff0040 #70ff00);
}

#error
{
	height: 32dp;
	margin-top: 4dp;
	color: #ff7b72;
}

#actions, #cancel-row, #done-actions
{
	display: flex;
	justify-content: space-between;
	margin-top: 10dp;
}

#cancel-row
{
	justify-content: center;
}

#actions button, #cancel-row button, #done-actions button
{
	width: 110dp;
}
