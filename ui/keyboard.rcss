/*
 * Where the keyboard screen puts its parts, from IDD_OPT_KEYBOARD at 336 by 208 dialog
 * units: 504 by 338 pixels, two columns of 207 and 219 inside a 33 pixel inset, the category
 * combo over the description group, the command list 219 by 169, and the buttons along the
 * bottom. Everything visual comes from the kit.
 */

#reveal
{
	width: 504dp;
	height: 338dp;
	top: 50%;
	margin-top: -169dp;
}

#content
{
	padding: 20dp 33dp 0 33dp;
}

#title
{
	height: 18dp;
	text-align: center;
}

#columns
{
	display: flex;
	margin-top: 6dp;
}

#left
{
	width: 207dp;
	margin-right: 12dp;
}

#right
{
	width: 219dp;
}

.caption
{
	display: block;
	line-height: 15dp;
}

.caption.tall
{
	margin-top: 9dp;
	line-height: 18dp;
}

.value
{
	display: block;
	margin-top: 7dp;
	line-height: 16dp;
	overflow: hidden;
}

#categories
{
	display: block;
	width: 207dp;
	margin-top: 9dp;
}

/* The group's frame starts a caption's half height below where its template rect does. */
#about
{
	margin-top: 8dp;
	height: 86dp;
}

#description
{
	height: 64dp;
	overflow: hidden;
}

#press
{
	margin-top: 7dp;
}

#hotkey-row
{
	margin-top: 5dp;
}

/* The field is 128 wide with its text four in, so the room inside the padding is 120. */
#capture
{
	display: inline-block;
	width: 120dp;
	height: 23dp;
	vertical-align: top;
	white-space: nowrap;
	overflow: hidden;
	tab-index: auto;
}

#assign
{
	width: 75dp;
	margin-left: 4dp;
	vertical-align: top;
}

#capture span
{
	focus: none;
}

#commands
{
	margin-top: 8dp;
	height: 169dp;
}

/* Reset on the left, then the pair that answers the screen at the right edge. */
#buttons
{
	display: flex;
	margin-top: 8dp;
}

#reset
{
	width: 81dp;
	margin-right: 167dp;
}

#ok
{
	width: 75dp;
	margin-right: 40dp;
}

#cancel
{
	width: 75dp;
}
