/*
 * Where the keyboard screen puts its parts, from IDD_OPT_KEYBOARD at 336 by 208 dialog
 * units: 504 pixels across, two columns of 207 and 219 inside a 33 pixel inset, the command
 * list 219 by 169, and the buttons along the bottom. The screen is taller than the template
 * because it picks a category from a list where the original dropped a combo box over the
 * description; the list needs room the dropdown borrowed.
 *
 * Everything visual comes from the kit.
 */

#reveal
{
	width: 504dp;
	height: 360dp;
	top: 50%;
	margin-top: -180dp;
}

#content
{
	padding: 20dp 33dp 0 33dp;
}

#title
{
	height: 18dp;
	text-align: center;
}

#columns
{
	display: flex;
	margin-top: 6dp;
}

#left
{
	width: 207dp;
	margin-right: 12dp;
}

#right
{
	width: 219dp;
}

.caption
{
	display: block;
	margin-top: 6dp;
	line-height: 15dp;
}

.column > .caption:first-child
{
	margin-top: 0;
}

.value
{
	display: block;
	line-height: 16dp;
	overflow: hidden;
}

#categories
{
	height: 72dp;
}

#commands
{
	height: 169dp;
}

#about
{
	margin-top: 10dp;
}

#description
{
	height: 42dp;
	overflow: hidden;
}

#hotkey-row
{
	margin-top: 4dp;
}

#capture
{
	display: inline-block;
	width: 128dp;
	height: 23dp;
	padding: 2dp 6dp;
	vertical-align: top;
	white-space: nowrap;
	overflow: hidden;
	tab-index: auto;
}

#assign
{
	width: 75dp;
	margin-left: 5dp;
	vertical-align: top;
}

#capture span
{
	focus: none;
}

/* Reset on the left, then the pair that answers the screen at the right edge. */
#buttons
{
	display: flex;
	margin-top: 10dp;
}

#reset
{
	width: 81dp;
	margin-right: 167dp;
}

#ok
{
	width: 75dp;
	margin-right: 40dp;
}

#cancel
{
	width: 75dp;
}
