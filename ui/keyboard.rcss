/*
 * Where the keyboard screen puts its parts, from IDD_OPT_KEYBOARD at 336 by 208 dialog
 * units: 504 by 339 pixels, two columns of 207 and 219 inside a 33 pixel inset, the category
 * combo over the description group, the command list 219 by 170, and the buttons along the
 * bottom. Everything visual comes from the kit.
 */

#reveal
{
	width: 504dp;
	height: 339dp;
	top: 50%;
	margin-top: -169dp;
}

#content
{
	padding: 19dp 33dp 0 33dp;
}

/* A caption is drawn from the top of its box, however tall the template makes the box. */
#title
{
	height: 18dp;
	line-height: 17dp;
	text-align: center;
}

#columns
{
	display: flex;
	margin-top: 7dp;
}

#left
{
	width: 207dp;
	margin-right: 12dp;
}

#right
{
	width: 219dp;
}

.caption
{
	display: block;
	height: 15dp;
	line-height: 17dp;
}

#right > .caption:first-child
{
	height: 13dp;
}

.caption.tall
{
	margin-top: 10dp;
	height: 18dp;
}

#right > .caption.tall
{
	margin-top: 8dp;
}

.value
{
	display: block;
	margin-top: 6dp;
	height: 17dp;
	line-height: 17dp;
	overflow: hidden;
}

#categories
{
	display: block;
	width: 207dp;
	margin-top: 8dp;
}

/* The group's frame starts a caption's half height below where its template rect does. */
#about
{
	margin-top: 9dp;
	height: 86dp;
	padding-left: 10dp;
}

#description
{
	height: 69dp;
	overflow: hidden;
}

#press
{
	margin-top: 7dp;
}

/* The field and its button fill the column exactly, so the row must never wrap them. */
#hotkey-row
{
	margin-top: 4dp;
	height: 23dp;
	white-space: nowrap;
}

/* The field is 128 wide with its text four in, so the room inside the padding is 120. */
#capture
{
	display: inline-block;
	width: 120dp;
	height: 23dp;
	vertical-align: top;
	white-space: nowrap;
	overflow: hidden;
	tab-index: auto;
}

/* The template puts the button two lower than the field beside it. */
#assign
{
	position: relative;
	top: 2dp;
	width: 75dp;
	margin-left: 4dp;
	vertical-align: top;
}

#capture span
{
	focus: none;
}

#commands
{
	margin-top: 10dp;
	height: 170dp;
}

/* Reset on the left, then the pair that answers the screen at the right edge. */
#buttons
{
	display: flex;
	margin-top: 9dp;
}

#reset
{
	width: 81dp;
	margin-right: 166dp;
}

#ok
{
	width: 75dp;
	margin-right: 41dp;
}

#cancel
{
	width: 75dp;
}
