/*
 * The controls the game's own dialogs are built from, in the colors and the metrics they
 * are drawn with. A screen links this first and its own sheet after, so its sheet overrides
 * and holds only where things go.
 *
 * Every length is in dp, so a screen keeps its proportion to the game frame at any window
 * size. The numbers are the originals' pixel values, which is what they come to at 1:1.
 *
 * The art is the player's own and is not shipped. Where a picture is missing it draws as
 * nothing, so each control is given a plain form underneath that stays usable without it.
 */

body
{
	width: 100%;
	height: 100%;
	font-family: dlgsys;
	font-size: 16dp;
	color: #70ff00;
}

div, form, h1, h2, p
{
	display: block;
}

/* ------------------------------------------------------------------ the dialog chrome */

/*
 * Nothing but a place to put the dialog. Whatever the game was drawing stays visible around
 * it, as it does behind a Win32 dialog.
 */
#backdrop
{
	width: 100%;
	height: 100%;
}

/*
 * The band a dialog opens through. It stays centred as it widens, so the chrome inside it
 * has to be placed against the screen rather than against the band: half the band across,
 * then back by half the dialog, which comes to the same place whatever the band's width.
 * Positioned so a screen can take the top edge the game hands it.
 *
 * The band is told to clip outright. RmlUi measures what it has to clip from the chrome's
 * static box, which the negative margin puts half a dialog to the left, and never counts
 * the relative offset that moves it back; once the band is wider than that half the chrome
 * would otherwise show whole.
 */
#reveal
{
	position: relative;
	height: 100%;
	margin: 0 auto;
	overflow: hidden;
	clip: always;
}

#chrome
{
	height: 100%;
}

/*
 * The wallpaper is one 640 by 400 picture centred on the screen, and a dialog shows the part
 * of it that lies behind the dialog, so it lines up with whatever the menu behind is drawing;
 * a dialog reaching past the picture is black there. It scales with the frame like the rest
 * of the kit: the original drew it at the size it was painted because it drew everything so.
 *
 * It hangs off the middle of the dialog, which is the middle of the screen for any dialog
 * the shell centres; a screen that moves itself elsewhere moves the picture back by as much.
 * Since it is larger than most dialogs it is held in a box of the dialog's own size that
 * cuts it off, and that box sits behind everything else the dialog draws: a positioned
 * element otherwise paints over the controls rather than behind them. The box is told to
 * clip outright, because RmlUi measures what a box has to clip before it lays out the
 * positioned children inside it, and so never sees the picture spilling over.
 */
#wallpaper
{
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	z-index: -1;
	overflow: hidden;
	clip: always;
	background-color: #000000;
	pointer-events: none;
}

#wallpaper-art
{
	position: absolute;
	left: 50%;
	top: 50%;
	width: 640dp;
	height: 400dp;
	margin-left: -320dp;
	margin-top: -200dp;
	decorator: image(dbak6440.pcx);
}

/*
 * Each edge is a bar tiled down the height of the dialog, its last repeat cut off at the
 * bottom, with a corner stamped over each end, as the original composes it. A tile keeps the
 * size the artist drew it, scaled with the frame. Decorators paint last to first, so the bar
 * is listed last to go underneath the corners.
 */
#bar-left, #bar-right
{
	position: absolute;
	top: 0;
	width: 24dp;
	height: 100%;
}

#bar-left { left: 0; decorator: image(bar_ul.pcx scale-none left top), image(bar_ll.pcx scale-none left bottom), image(leftbar.pcx repeat-y left top); }
#bar-right { right: 0; decorator: image(bar_ur.pcx scale-none left top), image(bar_lr.pcx scale-none left bottom), image(rightbar.pcx repeat-y left top); }

/*
 * The glow is sixteen rings of white, each one dimmer than the last, drawn one inside the
 * other: the original steps the alpha down by six a ring from ninety-six. That is a straight
 * ramp from ninety-six at the edge to nothing sixteen in, so each edge is one strip with
 * that ramp across it. Sixteen one-pixel rings would come to the same picture at one to one,
 * but at any other scale each ring rounds to the pixel grid on its own and the rings gap
 * and double up; a ramp has no rings to round. Where two strips meet at a corner both are
 * drawn, so a corner is a little brighter than the original's mitre.
 */
#glow, #bar-left, #bar-right, #edge-left, #edge-right
{
	pointer-events: none;
}

#glow
{
	position: absolute;
	left: 24dp;
	top: 0;
	right: 24dp;
	bottom: 0;
}

#glow > div
{
	position: absolute;
}

#glow-top { left: 0; right: 0; top: 0; height: 16dp; decorator: vertical-gradient(#ffffff60 #ffffff00); }
#glow-bottom { left: 0; right: 0; bottom: 0; height: 16dp; decorator: vertical-gradient(#ffffff00 #ffffff60); }
#glow-left { left: 0; top: 0; bottom: 0; width: 16dp; decorator: horizontal-gradient(#ffffff60 #ffffff00); }
#glow-right { right: 0; top: 0; bottom: 0; width: 16dp; decorator: horizontal-gradient(#ffffff00 #ffffff60); }

/*
 * The bars ride the opening edges while a dialog reveals and are gone once it is open. The
 * original stamps the bar alone there, without its corners.
 */
#edge-left, #edge-right
{
	display: none;
	position: absolute;
	top: 0;
	width: 24dp;
	height: 100%;
}

.revealing #edge-left { display: block; left: 0; decorator: image(leftbar.pcx repeat-y left top); }
.revealing #edge-right { display: block; right: 0; decorator: image(rightbar.pcx repeat-y left top); }

/* ------------------------------------------------------------------------- the controls */

/*
 * A control's width is the width its template gives it, frame included, so every one counts
 * its border and padding inside the size it is asked for.
 */
button, input, select, dataselect, option, progress, scrollbarvertical, textarea,
.list, .trough, .group, .hotkey, .tooltip
{
	box-sizing: border-box;
}

/*
 * The frame around an edit box, a list, a combo box, a track bar or a hotkey field is drawn
 * a pixel outside the control's rect, as the dialog layer drew it, so the rect a template
 * gives is the inside of the frame: the control is sized to that rect and its frame hangs
 * over the margin. A screen that spaces one from its neighbour does so from the neighbour's
 * side, and gives one that pads its text the width left inside the padding.
 */
input[type='range'], input[type='text'], input[type='password'], textarea, select, .list, .hotkey
{
	box-sizing: content-box;
	margin: -1dp;
	border: 1dp #4eb6dc;
}

/*
 * A button is a picture in three parts at one of two heights: a cap either side and a
 * middle tiled to whatever width the button is. The original draws no outline around one,
 * so the plain form underneath is a fill the picture covers rather than a border that would
 * show through it.
 *
 * The caption sits two down from the top of a short button and five down from a tall one.
 * Pressing moves the whole picture two down, and the caption four further down and two
 * across. A glyph is seventeen tall, so a short button has only seven to give: padding is
 * what moves the caption, the box counts its padding inside its own size so a pressed button
 * stays the size it was, and the line is left tall enough that the glyph is never cut off.
 */
button
{
	display: inline-block;
	box-sizing: border-box;
	height: 24dp;
	padding: 2dp 10dp 0 7dp;
	text-align: center;
	vertical-align: middle;
	line-height: 17dp;
	color: #70ff00;
	background-color: #2b2b2b;
	decorator: tiled-horizontal(bue_li24.pcx, bue_mi24.pcx, bue_ri24.pcx);
}

button.tall
{
	height: 30dp;
	padding-top: 5dp;
	decorator: tiled-horizontal(bue_li30.pcx, bue_mi30.pcx, bue_ri30.pcx);
}

button:active
{
	position: relative;
	top: 2dp;
	padding: 6dp 8dp 0 9dp;
	decorator: tiled-horizontal(bde_li24.pcx, bde_mi24.pcx, bde_ri24.pcx);
}

button.tall:active
{
	padding-top: 9dp;
	decorator: tiled-horizontal(bde_li30.pcx, bde_mi30.pcx, bde_ri30.pcx);
}

/*
 * Disabled is a half-black wash over the whole control rather than another picture: the
 * original loads a disabled skin but never asks for it.
 */
button.disabled, button:disabled
{
	background-color: #00000080;
	color: #70ff00;
}

/* A disabled button takes no press, as the original never hands one the mouse. */
button.disabled:active, button:disabled:active
{
	top: 0dp;
	padding: 2dp 10dp 0 7dp;
	decorator: tiled-horizontal(bue_li24.pcx, bue_mi24.pcx, bue_ri24.pcx);
}

button.tall.disabled:active, button.tall:disabled:active
{
	padding-top: 5dp;
	decorator: tiled-horizontal(bue_li30.pcx, bue_mi30.pcx, bue_ri30.pcx);
}

/*
 * A check box is an 18 by 19 picture with its label 20 across, vertically centred. Like a
 * button it is drawn without an outline, so its plain form is a fill the picture covers.
 * A control is matched on the type it was written with rather than on a class it would
 * otherwise have to carry.
 */
input[type='checkbox']
{
	display: inline-block;
	width: 18dp;
	height: 19dp;
	vertical-align: top;
	background-color: #2b2b2b;
	decorator: image(cue_i.pcx);
}

input[type='checkbox']:checked
{
	decorator: image(cce_i.pcx);
}

input[type='checkbox']:disabled
{
	background-color: #00000080;
}

/*
 * The label carries the box, so a whole switch is one element to place. The caption clears
 * the box by two beyond its width, as the original leaves it.
 */
label.check
{
	display: block;
	line-height: 19dp;
	min-height: 19dp;
}

label.check input[type='checkbox']
{
	margin-right: 2dp;
}

label.check.disabled, label.check:disabled
{
	color: #909090;
}

/*
 * The two places a static sits: the caption before a control and the reading after it. The
 * dialog layer draws a static on one line and never centres it in its box, so neither wraps
 * however little room its text is given.
 */
.caption, .value
{
	display: inline-block;
	white-space: nowrap;
	vertical-align: top;
}

/* Text the dialog layer draws through GDI rather than its bitmap font. */
.sans, input[type='text'], input[type='password'], textarea, .list, .tooltip, .hotkey, .group > label
{
	font-family: dlg-sans;
	font-size: 14dp;
}

input selection, textarea selection
{
	background-color: #225061;
	color: #70ff00;
}

input[type='text'], input[type='password'], textarea
{
	padding: 1dp;
	color: #70ff00;
	background-color: #000000b4;
	caret-color: #70ff00;
}

/*
 * A list row is fourteen tall with its text indented two, and a chosen row is filled to its
 * full width in the dark teal the original fills it with.
 */
.list
{
	font-size: 12dp;
	background-color: #000000b4;
	overflow-y: auto;
}

.list .item
{
	display: block;
	height: 14dp;
	line-height: 14dp;
	padding-left: 2dp;
	color: #70ff00;
}

.list .item:checked, .list .item.selected
{
	background-color: #225061;
}

/*
 * A scroll bar is twenty wide, its frame inside that, with a twenty-two tall arrow box at
 * each end. The track shows whatever lies behind it; an arrow box is lightened a little and
 * bevelled two deep, light at the top and left and dark at the bottom and right, the other
 * way round while it is pressed, with its arrow drawn over the bevel from the corner. The
 * grip is three pieces with the middle tiled, and the original shrinks it as the list
 * grows, never below fourteen.
 */
scrollbarvertical
{
	width: 20dp;
	border: 1dp #4eb6dc;
}

scrollbarvertical sliderbar
{
	width: 18dp;
	min-height: 14dp;
	background-color: #3c5a68;
	decorator: image(sbgript.pcx scale-none left top), image(sbgripb.pcx scale-none left bottom), image(sbgripm.pcx repeat-y left top);
}

scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc
{
	width: 18dp;
	height: 22dp;
	background-color: #ffffff28;
	border-width: 2dp;
	border-color: #ffffff7f #0000007f #0000007f #ffffff7f;
}

scrollbarvertical sliderarrowdec:active, scrollbarvertical sliderarrowinc:active
{
	border-color: #0000007f #ffffff7f #ffffff7f #0000007f;
}

scrollbarvertical sliderarrowdec { decorator: image(uparrowr.pcx scale-none left top) border-box; }
scrollbarvertical sliderarrowinc { decorator: image(dnarrowr.pcx scale-none left top) border-box; }
scrollbarvertical sliderarrowdec:active { decorator: image(uparrowp.pcx scale-none left top) border-box; }
scrollbarvertical sliderarrowinc:active { decorator: image(dnarrowp.pcx scale-none left top) border-box; }

/*
 * A track bar is as tall as its template makes it, with a twelve wide thumb drawn from the
 * top of it one in from the left; the thumb's travel is thirteen short of the width, which
 * is what a track a pixel narrower on the left comes to. Where the bar shows its value, that
 * number sits in a fifty wide field of its own, the trough, put after the bar in the same
 * row; the bar is then fifty narrower and the frame ends where the field begins.
 */
input[type='range']
{
	display: inline-block;
	vertical-align: top;
	background-color: #000000b4;
}

input[type='range'] slidertrack
{
	margin-left: 1dp;
}

input[type='range'] sliderbar
{
	width: 12dp;
	background-color: #70ff00;
	decorator: image(trakgrip.pcx scale-none left top);
}

input[type='range']:disabled
{
	background-color: #000000da;
	border-color: #909090;
}

.trough
{
	display: inline-block;
	width: 50dp;
	height: 24dp;
	vertical-align: top;
	text-align: center;
	line-height: 24dp;
	background-color: #000000b4;
	decorator: tiled-horizontal(trofl.pcx, trofm.pcx, trofr.pcx);
}

/*
 * The progress bar the original fills in red, solid across the middle of its height with the
 * outer quarters ramping away. The element carries its own fill, which is what is coloured.
 */
progress
{
	display: block;
	height: 22dp;
	background-color: #000000b4;
	border: 1dp #4eb6dc;
}

progress fill
{
	height: 100%;
	background-color: #ff0000;
	decorator: horizontal-gradient(#ff000040 #ff0000);
}

/*
 * A group box is a frame whose top edge runs through the middle of its caption, broken to
 * let the caption through: eight along, the caption, twelve clear, then on to the corner.
 * The frame's top edge is the caption row's two lines rather than a border, because a border
 * cannot be broken; the row straddles the frame, half above and half below.
 */
.group
{
	position: relative;
	border: 1dp #4eb6dc;
	border-top: 0;
	padding: 11dp;
}

.group > .rule
{
	display: flex;
	align-items: center;
	position: absolute;
	left: -1dp;
	right: -1dp;
	top: -7dp;
	height: 14dp;
	font-family: dlg-sans;
	font-size: 14dp;
	line-height: 14dp;
	color: #70ff00;
}

.group > .rule > span
{
	display: block;
	height: 1dp;
	background-color: #4eb6dc;
}

.group > .rule > span:first-child
{
	width: 8dp;
}

.group > .rule > label
{
	display: block;
	margin-left: 2dp;
	white-space: nowrap;
}

.group > .rule > span:last-child
{
	flex: 1;
	margin-left: 2dp;
}

/*
 * A combo box is a closed box, always twenty-four tall, with its arrow one in from the
 * right and the top, and a list that drops two under it with a row for each item, twenty
 * apart, a chosen row filled eighteen tall. The list is the toolkit's own child of the box,
 * so it is placed and shown by the toolkit and only styled here. The box is darkened forty
 * and washed a further half toward black, which comes to the one shade written here.
 */
select
{
	display: block;
	height: 24dp;
	color: #70ff00;
	background-color: #00000094;
}

select selectvalue
{
	padding: 3dp 0 0 2dp;
	line-height: 17dp;
	white-space: nowrap;
}

select selectarrow
{
	width: 18dp;
	height: 22dp;
	margin: 1dp 1dp 0 0;
	decorator: image(dnarrowr.pcx scale-none left top);
}

select selectbox
{
	margin-top: 2dp;
	padding: 2dp 0;
	background-color: #000000b4;
	border: 1dp #4eb6dc;
	overflow-y: auto;
}

select option
{
	display: block;
	height: 18dp;
	margin: 1dp 0;
	line-height: 18dp;
	padding-left: 3dp;
	color: #70ff00;
}

select option:checked
{
	background-color: #225061;
}

/* The field a keyboard screen shows a captured key in, its text four in from the frame. */
.hotkey
{
	display: block;
	padding: 0 4dp;
	color: #70ff00;
}

/* A tooltip is a dark box with a lighter bevel at its top and left, under the pointer. */
.tooltip
{
	padding: 3dp 4dp;
	color: #70ff00;
	background-color: #0b1b22;
	border: 1dp #4eb6dc;
}

.dim
{
	color: #109010;
}

.disabled
{
	color: #909090;
}
