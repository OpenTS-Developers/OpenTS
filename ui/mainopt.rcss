/*
 * Where the options menu puts its five buttons, taken from the dialog template the game
 * still ships: 200 by 148 dialog units with the buttons at x 37, width 126, height 18, and
 * tops 10, 32, 54, 76 and 120. The game's own rule turns a dialog unit into 1.5 pixels
 * across and 1.63 down, which makes the dialog 300 by 241 and a button 189 by 29. A button
 * that tall takes the 24 pixel skin with the rest as space around it, so the element here is
 * the skin and the gaps carry the difference.
 *
 * Everything visual comes from the kit.
 */

#reveal
{
	width: 300dp;
	height: 241dp;
	top: 50%;
	margin-top: -120dp;
}

#content
{
	padding-top: 18dp;
}

button
{
	display: block;
	width: 189dp;
	margin: 0 auto 12dp auto;
}

#mainmenu
{
	margin-top: 48dp;
}
