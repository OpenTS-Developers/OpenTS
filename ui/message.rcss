/*
 * Where the message box puts its text and its buttons. The box it replaces has three places
 * for buttons; two buttons take the outer pair and three take all three, which is what
 * spreading them across the row comes to. Everything visual comes from the kit.
 */

#reveal
{
	width: 390dp;
	height: 137dp;
	top: 50%;
	margin-top: -68dp;
}

#content
{
	padding: 20dp 33dp 0 33dp;
}

#text
{
	height: 62dp;
	overflow: hidden;
}

#text p
{
	text-align: center;
	line-height: 15dp;
	white-space: pre-wrap;
}

#buttons
{
	display: flex;
	justify-content: space-between;
	margin-top: 12dp;
}

#buttons.alone
{
	justify-content: center;
}

button
{
	width: 90dp;
}
