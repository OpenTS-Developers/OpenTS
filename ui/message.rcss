/*
 * Where the message box puts its text and its buttons, from IDD_MSGBOX_3 at 260 by 84 dialog
 * units: 390 by 137 pixels, the text at 33,19 over 324 by 62, and three 90 wide places for
 * buttons at 33, 150 and 267. Two buttons take the outer pair and three take all three,
 * which is what spreading them across the row comes to. Everything visual comes from the
 * kit.
 */

#reveal
{
	width: 390dp;
	height: 137dp;
	top: 50%;
	margin-top: -68dp;
}

#content
{
	padding: 19dp 33dp 0 33dp;
}

#text
{
	height: 62dp;
	overflow: hidden;
}

#text p
{
	text-align: center;
	line-height: 15dp;
	white-space: pre-wrap;
}

#buttons
{
	display: flex;
	justify-content: space-between;
	margin-top: 13dp;
}

#buttons.alone
{
	justify-content: center;
}

button
{
	width: 90dp;
}


/*
 * The network box is its own template, IDD_MSGBOX_3_SMALL at 290 by 90 dialog units: 436 by
 * 147 pixels, the text at 33,19 over 370 by 66, and 76 wide buttons on the row at 104. The
 * template puts a lone OK in the middle and the yes and no pair at 105 and 253, which is 72
 * in from the text's edge and 72 apart. MB_OKCANCEL is the one shape that takes a different
 * template, IDD_MSGBOX_2, whose pair stands at the text's edges instead; nothing calls it.
 */

.net #reveal
{
	width: 436dp;
	height: 147dp;
	margin-top: -73dp;
}

.net #text
{
	height: 66dp;
}

.net #buttons
{
	justify-content: flex-start;
	margin-top: 19dp;
}

.net #buttons button
{
	width: 76dp;
	margin-left: 72dp;
}

.net #buttons.alone
{
	justify-content: center;
}

.net #buttons.alone button
{
	margin-left: 0;
}
