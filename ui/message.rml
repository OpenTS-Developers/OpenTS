<rml>
<head>
	<title>Message</title>
	<link type="text/rcss" href="message.rcss"/>
</head>
<body data-model="message">
	<div id="panel">
		<div id="text">
			<p>{{text}}</p>
		</div>
		<button data-for="button : buttons" data-class-slot0="button.slot == 0" data-class-slot1="button.slot == 1" data-class-slot2="button.slot == 2" data-event-click="queue('button', button.index)">{{button.caption}}</button>
	</div>
</body>
</rml>
