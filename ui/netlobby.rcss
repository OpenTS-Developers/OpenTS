/*
 * Where the network game browser puts its controls, from IDD_MPLAYER_GAME_LIST at 426 by 240
 * dialog units: 640 by 391 pixels, the same frame the skirmish setup comes to. Nothing here
 * sits in a row with anything else, so each control is placed at the rect the dialog layer
 * drew it at rather than flowed against its neighbours, the way the saved-game list places
 * its cells. Everything visual comes from the kit.
 *
 * The measured rects, dialog-relative: the name box at 133,13 over 103 by 21 with its caption
 * at 36,14; the chat log at 28,44 over 400 by 271 and the line the player types at 28,322
 * over 401 by 21; the games at 441,44 over 170 by 111 under a caption at 444,22; the players
 * at 441,181 over 170 by 163 under one at 444,161; and the three buttons on the row at 350,
 * each 94 by 24, at 271, 396 and 517.
 */

#reveal
{
	width: 640dp;
	height: 391dp;
	top: 50%;
	margin-top: -195dp;
}

#content
{
	position: relative;
	padding: 0;
}

#content > *
{
	position: absolute;
}

.caption
{
	height: 17dp;
	line-height: 17dp;
}

#cap-name { left: 36dp; top: 14dp; }
#cap-games { left: 444dp; top: 22dp; }
#cap-players { left: 444dp; top: 161dp; }

/*
 * An edit box here is placed rather than flowed, so it carries its frame inside its size
 * instead of hanging it over a margin, and its text is inset by the frame alone.
 */
#handle, #say
{
	box-sizing: border-box;
	margin: 0;
	padding: 0;
}

#handle { left: 133dp; top: 13dp; width: 103dp; height: 21dp; }
#say { left: 28dp; top: 322dp; width: 401dp; height: 21dp; }

#chat { left: 28dp; top: 44dp; width: 400dp; height: 271dp; }
#games { left: 441dp; top: 44dp; width: 170dp; height: 111dp; }
#players { left: 441dp; top: 181dp; width: 170dp; height: 163dp; }

/*
 * A chat message is stored whole and broken into lines here, where the layer handed the list
 * box lines it had already broken to the box's width.
 */
#chat .line
{
	display: block;
	margin: 0;
	padding-left: 2dp;
	line-height: 14dp;
	white-space: pre-wrap;
}

#cancel { left: 271dp; top: 350dp; }
#join { left: 396dp; top: 350dp; }
#new { left: 517dp; top: 350dp; }

#cancel, #join, #new
{
	width: 94dp;
}
