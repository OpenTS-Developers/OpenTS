/*
 * Where the saved-game dialogs put their parts. All three are 302 by 198 dialog units, which
 * the game draws 454 by 323: a centered title at 33,19, the column headings at 42, the file list, and two 76
 * wide buttons whose first one sits where each template puts it. Loading gives the list the
 * room the other two leave for the description box; saving carries that box under a shorter
 * list. The game draws the saving list a pixel taller than its template alone would make it,
 * and the loading buttons a row lower, so the sheet follows the game.
 *
 * The templates carry a "Mission" heading between the other two, and the list a cell under it
 * marking a game that is not a campaign mission. The game draws neither, so the document
 * leaves that column out as well.
 *
 * Everything visual comes from the kit.
 */

#reveal
{
	width: 454dp;
	height: 323dp;
	top: 50%;
	margin-top: -161dp;
}

#content
{
	padding: 19dp 33dp 0 33dp;
}

#title
{
	height: 14dp;
	padding-right: 1dp;
	line-height: 17dp;
	text-align: center;
}

#headings
{
	margin-top: 9dp;
	height: 14dp;
	line-height: 17dp;
	white-space: nowrap;
}

#heading-description
{
	display: inline-block;
	width: 182dp;
}

/*
 * A centered static takes its template's width without the pixel a control's size otherwise
 * gains, and sits a pixel left of the middle when the room is odd, so the box is padded on
 * the right to bring the toolkit's rounding down to the layer's.
 */
#heading-stamp
{
	display: inline-block;
	width: 108dp;
	margin-left: 79dp;
	padding-right: 1dp;
	text-align: center;
}

.save #heading-stamp
{
	width: 99dp;
	margin-left: 83dp;
}

.delete #heading-stamp
{
	width: 106dp;
}

#files
{
	margin-top: 9dp;
	height: 202dp;
}

.save #files, .delete #files
{
	margin-top: 12dp;
}

.save #files
{
	height: 172dp;
}

.delete #files
{
	height: 199dp;
}

/*
 * A row is three cells the layer drew at fixed places across the list: the description at
 * the row's indent, then the date and the time. Each keeps its place whatever the one
 * before it holds, as the layer's cells did, so they are placed rather than flowed. A
 * placed cell starts from the row's edge rather than inside its padding, so these are the
 * positions the layer used, counted from the inside of the list's frame.
 */
.item
{
	position: relative;
}

.item > span
{
	position: absolute;
	top: 0;
	white-space: nowrap;
}

.cell-description
{
	left: 2dp;
}

.cell-date
{
	left: 255dp;
}

.cell-time
{
	left: 315dp;
}

/*
 * The box counts its border and its one pixel of padding outside the size it is given, and
 * the game draws its frame on the rect's left edge rather than a pixel outside it, so this
 * one keeps the kit's overhang at the top and bottom only.
 */
#description
{
	margin-top: 10dp;
	margin-left: 0;
	margin-right: 0;
	height: 21dp;
	width: 385dp;
}

#buttons
{
	display: flex;
	margin-top: 12dp;
}

.save #buttons
{
	margin-top: 5dp;
}

.delete #buttons
{
	margin-top: 13dp;
}

button
{
	width: 76dp;
}

#accept
{
	margin-left: 223dp;
	margin-right: 13dp;
}

.save #accept
{
	margin-left: 228dp;
	margin-right: 8dp;
}

.delete #accept
{
	margin-left: 226dp;
	margin-right: 10dp;
}
