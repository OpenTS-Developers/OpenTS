#reveal
{
	width: 540dp;
	height: 326dp;
	top: 50%;
	margin-top: -163dp;
}

#content
{
	padding: 19dp 32dp 0 33dp;
}

#title
{
	width: 472dp;
	height: 20dp;
	line-height: 17dp;
	text-align: center;
}

#filters
{
	display: flex;
	align-items: center;
	margin-top: 4dp;
}

#find, #players, #theater, #source
{
	box-sizing: border-box;
	height: 26dp;
}

#find
{
	width: 116dp;
	font-family: dlgsys;
	line-height: 17dp;
	padding: 4dp 1dp 0 2dp;
	margin-right: 6dp;
}

#players
{
	width: 96dp;
	margin-right: 6dp;
}

#theater
{
	width: 100dp;
	margin-right: 6dp;
}

#source
{
	width: 118dp;
}

#columns
{
	display: flex;
	margin-top: 4dp;
}

#maps
{
	width: 263dp;
	height: 192dp;
	margin-right: 17dp;
}

#detail
{
	display: flex;
	flex-direction: column;
	width: 195dp;
}

#map
{
	position: relative;
	width: 195dp;
	height: 132dp;
}

#preview
{
	position: absolute;
	left: -1dp;
	top: -1dp;
	width: 194dp;
	height: 131dp;
}

#meta
{
	display: block;
	width: 195dp;
	height: 16dp;
	margin-top: 4dp;
	font-family: dlg-sans;
	font-size: 13dp;
	line-height: 16dp;
	text-align: center;
	white-space: nowrap;
	overflow: hidden;
}

#buttons
{
	display: flex;
	margin-top: 9dp;
}

#ok
{
	width: 76dp;
	margin-right: 89dp;
}

#random
{
	width: 160dp;
	margin-right: 74dp;
}

#cancel
{
	width: 76dp;
}
