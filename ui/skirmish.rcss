#reveal
{
	width: 640dp;
	height: 391dp;
	top: 50%;
	margin-top: -195dp;
}

#content
{
	display: flex;
	flex-direction: column;
	box-sizing: border-box;
	height: 100%;
	padding: 14dp 32dp 0 33dp;
}

#top
{
	flex: 0 0 auto;
	display: flex;
}

#player
{
	width: 180dp;
	margin-right: 14dp;
}

#player > .caption
{
	display: block;
	height: 14dp;
	line-height: 17dp;
}

#handle
{
	width: 168dp;
	box-sizing: border-box;
	height: 24dp;
	font-family: dlgsys;
	line-height: 17dp;
	padding: 4dp 0 0 2dp;
	margin-top: 12dp;
	margin-left: 0;
	background-color: #00000094;
}

#side
{
	width: 170dp;
	margin-top: 2dp;
}

#color
{
	width: 170dp;
	margin-top: 2dp;
}

#team
{
	width: 170dp;
	margin-top: 2dp;
}

#map
{
	flex: 1 1 auto;
	min-width: 0;
}

#map-head
{
	display: flex;
	height: 24dp;
}

#mapname
{
	flex: 1 1 auto;
	min-width: 0;
	height: 17dp;
	line-height: 17dp;
	padding-top: 4dp;
	white-space: nowrap;
	overflow: hidden;
}

#changemap
{
	width: 104dp;
}

#mapframe
{
	position: relative;
	height: 140dp;
	margin-top: 2dp;
}

#preview
{
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
}

#ai
{
	flex: 1 1 auto;
	display: flex;
	flex-direction: column;
	min-height: 0;
	margin-top: 10dp;
}

#ai-head
{
	flex: 0 0 auto;
	display: flex;
	height: 22dp;
}

#ai-title
{
	flex: 1 1 auto;
	height: 17dp;
	line-height: 17dp;
}

#ai-count
{
	flex: 0 0 auto;
	display: flex;
}

#aisub, #aiadd
{
	width: 22dp;
}

#aiplayers
{
	display: block;
	width: 30dp;
	line-height: 17dp;
	padding-top: 3dp;
	text-align: center;
}

#ai-cols
{
	flex: 0 0 auto;
	display: flex;
	height: 16dp;
}

#ai-cols > span
{
	font-family: dlg-sans;
	font-size: 13dp;
	line-height: 16dp;
	color: #4eb6dc;
}

#aislots
{
	flex: 1 1 auto;
	min-height: 0;
}

#aislots select
{
	font-family: dlgsys;
}

#aislots .ai-row
{
	display: flex;
	align-items: center;
	height: 25dp;
}

.c-num
{
	display: block;
	width: 22dp;
	margin-right: 4dp;
	font-family: dlg-sans;
	font-size: 13dp;
	line-height: 16dp;
	text-align: center;
}

.c-side
{
	display: block;
	width: 128dp;
	margin-right: 4dp;
}

.c-color
{
	display: block;
	width: 128dp;
	margin-right: 4dp;
}

.c-level
{
	display: block;
	width: 128dp;
	margin-right: 4dp;
}

.c-team
{
	display: block;
	width: 128dp;
}

#bottom
{
	flex: 0 0 auto;
	display: flex;
	margin-top: 10dp;
}

#options
{
	width: 104dp;
}

#buttons
{
	display: flex;
	margin-left: auto;
}

#ok
{
	width: 76dp;
	margin-right: 14dp;
}

#cancel
{
	width: 76dp;
}
