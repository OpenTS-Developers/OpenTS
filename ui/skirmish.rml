<rml>
<head>
	<title>Skirmish</title>
	<link type="text/template" href="dialog.rml"/>
	<link type="text/rcss" href="skirmish.rcss"/>
</head>
<body template="dialog" data-model="skirmish">
	<div id="top">
		<div id="player">
			<span class="caption">Name:</span>
			<input type="text" id="handle" maxlength="11" data-value="handle" data-event-change="queue('handle', ev.value)"/>
			<span class="caption">Side:</span>
			<select id="side" data-event-change="queue('side', ev.value)">
				<option data-for="entry : sides" data-attr-value="it_index" data-attrif-selected="it_index == side">{{entry.label}}</option>
			</select>
			<span class="caption">Color:</span>
			<select id="color" data-event-change="queue('color', ev.value)">
				<option data-for="entry : colors" data-attr-value="it_index" data-attrif-selected="it_index == color" data-style-color="entry.color">{{entry.label}}</option>
			</select>
			<span class="caption">Team:</span>
			<select id="team" data-event-change="queue('team', ev.value)">
				<option value="0" data-attrif-selected="team == 0">None</option>
				<option value="1" data-attrif-selected="team == 1">Team 1</option>
				<option value="2" data-attrif-selected="team == 2">Team 2</option>
				<option value="3" data-attrif-selected="team == 3">Team 3</option>
				<option value="4" data-attrif-selected="team == 4">Team 4</option>
			</select>
		</div>
		<div id="map">
			<div id="map-head">
				<span id="mapname">{{mapname}}</span>
				<button id="changemap" data-event-click="queue('map')">Change Map</button>
			</div>
			<div id="mapframe" class="frame"><surface id="preview"/></div>
		</div>
	</div>
	<div id="ai">
		<div id="ai-head">
			<span id="ai-title">AI Opponents</span>
			<span id="ai-count"><button id="aisub" data-event-click="queue('aisub')">-</button><span id="aiplayers">{{aiplayers}}</span><button id="aiadd" data-event-click="queue('aiadd')">+</button></span>
		</div>
		<div id="ai-cols">
			<span class="c-num"></span>
			<span class="c-side">Side</span>
			<span class="c-color">Color</span>
			<span class="c-level">Difficulty</span>
			<span class="c-team">Team</span>
		</div>
		<div id="aislots" class="list"><div class="rows">
			<div class="ai-row" data-for="slot : ai">
				<span class="c-num">{{it_index + 1}}</span>
				<select class="c-side" data-event-change="queue('aiside', it_index, ev.value)">
					<option value="-1" data-attrif-selected="slot.side == -1">Random</option>
					<option data-for="entry : sides" data-attr-value="entry.value" data-attrif-selected="entry.value == slot.side">{{entry.label}}</option>
				</select>
				<select class="c-color" data-event-change="queue('aicolor', it_index, ev.value)">
					<option value="-1" data-attrif-selected="slot.color == -1">Random</option>
					<option data-for="entry : colors" data-attr-value="entry.value" data-attrif-selected="entry.value == slot.color" data-style-color="entry.color">{{entry.label}}</option>
				</select>
				<select class="c-level" data-event-change="queue('aidiff', it_index, ev.value)">
					<option value="0" data-attrif-selected="slot.level == 0">Easy</option>
					<option value="1" data-attrif-selected="slot.level == 1">Normal</option>
					<option value="2" data-attrif-selected="slot.level == 2">Hard</option>
				</select>
				<select class="c-team" data-event-change="queue('aiteam', it_index, ev.value)">
					<option value="0" data-attrif-selected="slot.team == 0">None</option>
					<option value="1" data-attrif-selected="slot.team == 1">Team 1</option>
					<option value="2" data-attrif-selected="slot.team == 2">Team 2</option>
					<option value="3" data-attrif-selected="slot.team == 3">Team 3</option>
					<option value="4" data-attrif-selected="slot.team == 4">Team 4</option>
				</select>
			</div>
		</div></div>
	</div>
	<div id="bottom">
		<button id="options" data-event-click="queue('options')">Options...</button>
		<div id="buttons">
			<button id="ok" data-event-click="queue('ok')">[[TXT_OK]]</button>
			<button id="cancel" data-event-click="queue('cancel')">[[TXT_CANCEL]]</button>
		</div>
	</div>
</body>
</rml>
