/*
 * Where the sound options put their parts. In a game it is IDD_SOUND_OPTIONS_DIALOG at 294
 * by 215 dialog units, 441 by 349 pixels: three volume rows of a 105 wide label and a 263
 * wide slider, then the track list with its buttons and switches beside it, and OK at the
 * right. Out of one it is IDD_SOUND_OPTIONS_DIALOG_LITE at 294 by 112, 441 by 182: the same
 * three rows on their own with OK under them. Everything visual comes from the kit.
 */

#reveal
{
	width: 441dp;
	height: 349dp;
	top: 50%;
	margin-top: -174dp;
}

.lite #reveal
{
	height: 182dp;
	margin-top: -91dp;
}

#content
{
	padding: 20dp 32dp 0 33dp;
}

.lite #content
{
	padding-top: 28dp;
}

.row
{
	display: block;
	height: 24dp;
}

#row-sound
{
	margin-top: 11dp;
}

#row-voice
{
	margin-top: 12dp;
}

.lite #row-sound
{
	margin-top: 13dp;
}

.row > .caption
{
	display: inline-block;
	width: 105dp;
	line-height: 24dp;
	text-align: right;
	vertical-align: top;
}

.row > input[type='range']
{
	width: 263dp;
	margin-left: 8dp;
	vertical-align: top;
}

/* The lite template holds its sliders three across from the labels and three shorter. */
.lite .row > input[type='range']
{
	width: 260dp;
	margin-left: 11dp;
}

/* The list stands beside the column of buttons and switches. */
#music
{
	display: flex;
	margin-top: 18dp;
}

#music-side
{
	width: 105dp;
	margin-right: 8dp;
}

#play
{
	display: block;
	width: 105dp;
	margin-top: 7dp;
}

#stop
{
	display: block;
	width: 105dp;
	margin-top: 21dp;
}

#switch-shuffle
{
	margin-top: 21dp;
}

#switch-repeat
{
	margin-top: 20dp;
}

#tracks
{
	width: 263dp;
	height: 161dp;
}

#ok
{
	display: block;
	width: 93dp;
	margin: 13dp 0 0 282dp;
}

/* On its own the OK button sits in the middle instead of at the right edge. */
.lite #ok
{
	margin: 15dp auto 0 auto;
}
