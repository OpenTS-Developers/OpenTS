/*
 * Where the sound options put their parts. In a game it is IDD_SOUND_OPTIONS_DIALOG at 294
 * by 215 dialog units, 441 by 351 pixels: three volume rows of a 105 wide label and a 263
 * by 25 track bar, the last fifty of which is the field the bar shows its volume in, then
 * the track list with its buttons and switches beside it, and OK at the right. Out of one
 * it is IDD_SOUND_OPTIONS_DIALOG_LITE at 294 by 112, 442 by 183: the same three rows on
 * their own with OK under them. Everything visual comes from the kit.
 */

#reveal
{
	width: 441dp;
	height: 351dp;
	top: 50%;
	margin-top: -175dp;
}

/* Out of a game the dialog comes out a pixel wider than its template's unit and a half. */
.lite #reveal
{
	width: 442dp;
	height: 183dp;
	margin-top: -91dp;
}

#content
{
	padding: 19dp 33dp 0 33dp;
}

.lite #content
{
	padding-top: 28dp;
}

.row
{
	display: block;
	height: 25dp;
	white-space: nowrap;
}

#row-sound
{
	margin-top: 11dp;
}

#row-voice
{
	margin-top: 11dp;
}

.lite #row-sound
{
	margin-top: 12dp;
}

/* A caption is drawn from the top of its box, however tall the template makes the box. */
/* A right-aligned run ends a pixel further from the edge in the original, hence the pad. */
.row > .caption
{
	width: 105dp;
	height: 25dp;
	margin-right: 7dp;
	padding-right: 1dp;
	line-height: 17dp;
	text-align: right;
}

.row > input[type='range']
{
	width: 213dp;
	height: 25dp;
}

/*
 * The lite template holds its sliders three across from the labels and three shorter, and
 * gives the second and third labels a pixel more than the first.
 */
.lite .row > .caption
{
	width: 106dp;
	margin-right: 9dp;
}

.lite #row-sound > .caption, .lite #row-voice > .caption
{
	width: 107dp;
	margin-right: 8dp;
}

.lite .row > input[type='range']
{
	width: 210dp;
}

/* The list stands beside the column of buttons and switches. */
#music
{
	display: flex;
	margin-top: 17dp;
}

#music-side
{
	width: 105dp;
	margin-right: 7dp;
}

#play
{
	display: block;
	width: 105dp;
	margin-top: 7dp;
}

#stop
{
	display: block;
	width: 105dp;
	margin-top: 20dp;
}

#switch-shuffle
{
	margin-top: 20dp;
}

#switch-repeat
{
	margin-top: 25dp;
}

#tracks
{
	width: 263dp;
	height: 162dp;
}

#ok
{
	display: block;
	width: 94dp;
	margin: 13dp 0 0 282dp;
}

/* On its own the OK button sits in the middle instead of at the right edge. */
.lite #ok
{
	margin: 14dp 0 0 139dp;
}
