body
{
	width: 100%;
	height: 100%;
	font-family: "Open Sans";
	font-size: 15dp;
	color: #e6e6e6;
	pointer-events: none;
}

body > *
{
	pointer-events: auto;
}

div, h1, p
{
	display: block;
}

#panel
{
	position: absolute;
	left: 16dp;
	top: 16dp;
	width: 300dp;
	padding: 12dp 14dp;
	background-color: #12181fdc;
	border: 1dp #5a8f6a;
}

h1
{
	font-size: 20dp;
	font-weight: bold;
	margin-bottom: 8dp;
}

p
{
	margin-bottom: 12dp;
	line-height: 1.35em;
}

button
{
	display: inline-block;
	padding: 6dp 16dp;
	background-color: #2f4a5a;
	border: 1dp #6f95a8;
}

button:hover
{
	background-color: #3f6478;
}

button:active
{
	background-color: #24394a;
}
