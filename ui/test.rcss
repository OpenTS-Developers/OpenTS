/*
 * The developer's look at the control kit: one of each, laid out to be seen rather than to
 * copy any dialog. Positions only; anything visual here would mean the kit is short a
 * control.
 */

#content
{
	padding: 16dp;
}

h1
{
	font-size: 16dp;
	margin-bottom: 4dp;
}

p
{
	margin-bottom: 12dp;
}

.row
{
	display: block;
	margin-bottom: 12dp;
}

.row > button
{
	margin-right: 8dp;
	width: 96dp;
}

/* Side by side here, where a dialog stacks them. */
.row > label.check
{
	display: inline-block;
	margin-right: 16dp;
}

#rows
{
	display: inline-block;
	width: 180dp;
	height: 90dp;
	vertical-align: top;
}

.stack
{
	display: inline-block;
	width: 200dp;
	margin-left: 12dp;
	vertical-align: top;
}

.stack > *
{
	margin-bottom: 8dp;
}

.group > input[type='range']
{
	width: 120dp;
	vertical-align: middle;
}

.group > .trough
{
	vertical-align: middle;
}

.tooltip
{
	width: 90dp;
}

#edit
{
	width: 240dp;
	height: 20dp;
}
