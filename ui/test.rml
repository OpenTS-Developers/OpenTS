<rml>
<head>
	<title>UI shell test</title>
	<link type="text/template" href="dialog.rml"/>
	<link type="text/rcss" href="test.rcss"/>
</head>
<body template="dialog">
	<h1>OpenTS control kit</h1>
	<p class="sans">Every control the dialogs are built from, drawn by bgfx over the game. Without the game's own art each one falls back to a plain form. F9 brings this back.</p>

	<div class="row">
		<button id="close">Close</button>
		<button class="tall">Tall</button>
		<button class="disabled">Disabled</button>
	</div>

	<div class="row">
		<label class="check"><input type="checkbox"/>Check box</label>
		<label class="check"><input type="checkbox" checked="checked"/>Checked</label>
		<label class="check disabled"><input type="checkbox" disabled="disabled"/>Disabled</label>
	</div>

	<div class="row">
		<div class="list" id="rows">
			<div class="item selected">A chosen row</div>
			<div class="item">A second row</div>
			<div class="item">A third row</div>
			<div class="item">A fourth row</div>
			<div class="item">A fifth row</div>
			<div class="item">A sixth row</div>
		</div>
		<div class="stack">
			<div class="group">
				<label>Group box</label>
				<input type="range" id="level" min="0" max="10" step="1" value="6"/>
				<span class="trough">6</span>
			</div>
			<div class="hotkey">Ctrl+Shift+K</div>
			<progress id="progress" value="0.4"/>
			<div class="tooltip">A tool tip</div>
		</div>
	</div>

	<div class="row">
		<input type="text" id="edit" value="An edit box"/>
	</div>
</body>
</rml>
