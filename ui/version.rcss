/*
 * Where the version dialog puts its two parts, from IDD_VERSION at 272 by 106 dialog units:
 * 408 by 173 pixels, the lines in a 342 by 90 list at 33,19 and a 75 wide button under
 * them. Everything visual comes from the kit.
 */

#reveal
{
	width: 408dp;
	height: 173dp;
	top: 50%;
	margin-top: -86dp;
}

#content
{
	padding: 19dp 33dp 0 33dp;
}

#lines
{
	height: 90dp;
}

#ok
{
	display: block;
	width: 75dp;
	margin: 21dp auto 0 auto;
}
