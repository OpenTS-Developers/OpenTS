/*
 * Where the version dialog puts its two parts: the lines it reports and the button that
 * dismisses them. Everything visual comes from the kit.
 */

#reveal
{
	width: 408dp;
	height: 172dp;
	top: 50%;
	margin-top: -86dp;
}

#content
{
	padding: 20dp 33dp 0 33dp;
}

#lines
{
	height: 89dp;
}

#ok
{
	display: block;
	width: 75dp;
	margin: 21dp auto 0 auto;
}
