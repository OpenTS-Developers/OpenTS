/*
 * Where the wait notice puts its message and, while one is running, its bar. Everything
 * visual comes from the kit.
 */

#reveal
{
	width: 327dp;
	height: 104dp;
	top: 50%;
	margin-top: -52dp;
}

#content
{
	padding: 20dp 33dp 0 33dp;
}

#text
{
	height: 37dp;
	line-height: 18dp;
	text-align: center;
	white-space: pre-wrap;
}

/* The frame the progress dialog measures its bar from is 100 by 15 units: 150 by 24. */
#bar
{
	width: 150dp;
	height: 24dp;
	margin: 5dp auto 0 auto;
}
